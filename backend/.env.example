# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection (Set this in Render Environment Settings)
# For local development, this defaults to mongodb://127.0.0.1:27017 if left blank.
# In production on Render, set this to your MongoDB Atlas SRV connection string:
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-address>.mongodb.net/?retryWrites=true&w=majority

# Database & Collection Names
DB_NAME=queueflow_db
COLLECTION_NAME=tokens

# Cross-Origin Resource Sharing (Set to your deployed Vercel frontend URL without trailing slash)
# Example: CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
CORS_ORIGIN=https://YOUR-VERCEL-DOMAIN.vercel.app
