# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection (Set this in Render Environment Settings)
# For local development, this defaults to mongodb://127.0.0.1:27017 if left blank
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@queueflow.b21m9fx.mongodb.net/

# Database & Collection Names
DB_NAME=queueflow_db
COLLECTION_NAME=tokens

# Cross-Origin Resource Sharing (Set to your Vercel frontend URL, e.g. https://your-queueflow.vercel.app)
CORS_ORIGIN=https://queueflow-frontend-wine.vercel.app/
